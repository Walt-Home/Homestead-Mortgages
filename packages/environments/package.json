{
  "name": "@hm/environments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "env:refi": "tsx src/cli.ts",
    "env:compare": "tsx src/compare-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@hm/kernel": "*",
    "@hm/refi-review": "*"
  },
  "devDependencies": {
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
