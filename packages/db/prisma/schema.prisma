// Homestead Mortgages — the underwriting file.
//
// Two shapes live here and they answer to different masters.
//
// The RELATIONAL tables are things the product queries: files, borrowers,
// consents, conditions, events. The JSONB SNAPSHOT tables are what a vendor
// actually returned, stored verbatim and never updated. That split is
// deliberate — a credit report is evidence, and evidence that gets normalized
// into columns loses the thing that made it evidence. When an auditor asks
// what the bureau said on the day we decided, the answer has to be the bytes
// the bureau sent, not our reading of them.
//
// Every snapshot is append-only. Nothing in this schema updates one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PEOPLE WHO SIGN IN ─────────────────────────────────────────────────────

/// A signed-in person.
///
/// Identity comes from Google and nothing else — there is no password column
/// here and there must never be one. `googleSub` is the stable subject claim
/// and is the real key; email is stored for display and can change, which is
/// why it is not what we join on.
///
/// Access is restricted to the trywalt.ai Workspace domain by the OAuth app
/// being Internal, so Google refuses non-domain accounts before we ever see a
/// token. `hostedDomain` records what the token actually asserted, because
/// "Google enforces it" is a claim worth being able to audit.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  googleSub    String  @unique @map("google_sub")
  email        String  @unique
  name         String?
  pictureUrl   String? @map("picture_url")
  hostedDomain String? @map("hosted_domain")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  /// Set only by the persona seed. A session for such a user is read-only
  /// everywhere (middleware/persona-read-only.ts) and DELETE /api/auth/me
  /// refuses it. The seed is idempotent on this key.
  personaKey String? @unique @map("persona_key")

  /// The durable person behind this sign-in. Null until the first thing is
  /// written about them; found-or-created by the party service, never by a
  /// route. This is what a second application reuses instead of re-asking.
  partyId String? @unique @map("party_id") @db.Uuid
  party   Party?  @relation("UserParty", fields: [partyId], references: [id], onDelete: SetNull)

  loanFiles LoanFile[]

  @@map("users")
}

// ─── THE FILE ───────────────────────────────────────────────────────────────

enum FlowStage {
  PROPERTY_LOAN
  IDENTITY
  CREDIT
  /// Section 5 and where the borrower lives — asked between the credit pull
  /// and the bank connection, which is where the screen sits. A stage of its
  /// own rather than a second meaning for IDENTITY, because the stage is what
  /// "resume where you left off" reads: without one, a borrower who stops
  /// halfway through the questions comes back to the top of the screen before
  /// them and cannot be resumed to the one they were on.
  DECLARATIONS
  BANK
  PAYROLL
  IRS_TRANSCRIPT
  UPLOAD_FALLBACK
  DECISION
  PERSISTENT_CONSENT
  COMPLETE
}

enum LoanPurpose {
  PURCHASE
  RATE_TERM_REFINANCE
  CASH_OUT_REFINANCE
}

model LoanFile {
  id    String    @id @default(uuid()) @db.Uuid
  stage FlowStage @default(PROPERTY_LOAN)

  /// Who created it. Null for the legacy demo files; a persona file is a demo
  /// file that belongs to its persona user, so `assertFileAccess` makes it
  /// readable by all and writable by none while its persona session sees it
  /// as theirs.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A seeded fixture file, readable by everyone signed in and writable by no
  /// one. It exists so the team has a common artifact to critique without
  /// anyone's own file becoming shared — which is a data model we would have
  /// to unwind later.
  isDemo Boolean @default(false) @map("is_demo")

  // Screen 1. Nullable because a file exists the moment somebody starts, and
  // the whole point of the flow is that it is useful before it is complete.
  purpose                      LoanPurpose?
  loanAmount                   Decimal?     @map("loan_amount") @db.Decimal(14, 2)
  downPayment                  Decimal?     @map("down_payment") @db.Decimal(14, 2)
  cashToBorrower               Decimal?     @map("cash_to_borrower") @db.Decimal(14, 2)
  cashOutPurpose               String?      @map("cash_out_purpose")
  juniorLienBalance            Decimal      @default(0) @map("junior_lien_balance") @db.Decimal(14, 2)
  juniorLienCreditLimit        Decimal      @default(0) @map("junior_lien_credit_limit") @db.Decimal(14, 2)
  interestedPartyContributions Decimal      @default(0) @map("interested_party_contributions") @db.Decimal(14, 2)

  // Subject property, flattened — one property per file, always.
  propertyLine1         String?  @map("property_line1")
  propertyLine2         String?  @map("property_line2")
  propertyCity          String?  @map("property_city")
  propertyState         String?  @map("property_state") @db.VarChar(2)
  propertyPostalCode    String?  @map("property_postal_code")
  propertyType          String?  @map("property_type")
  occupancy             String?
  valueOrPrice          Decimal? @map("value_or_price") @db.Decimal(14, 2)
  valuationSource       String?  @map("valuation_source")
  addressVerified       Boolean  @default(false) @map("address_verified")
  financedPropertyCount Int      @default(1) @map("financed_property_count")

  // Product
  productCode  String?  @map("product_code")
  termMonths   Int?     @map("term_months")
  amortization String?
  noteRate     Decimal? @map("note_rate") @db.Decimal(6, 4)
  overlays     String[] @default([])

  // The TRID application moment (APP-002) is not a column on this table. It is
  // the INTAKE_RECEIVED row on the application's ledger, stamped by the receipt
  // trigger when the sixth piece is pinned, and the clock hangs off that row. A
  // second copy of the moment beside it could only ever disagree with it, and
  // for a while it did.
  intentToProceedAt    DateTime? @map("intent_to_proceed_at")
  /// When the borrower signed the application package in step 4.
  applicationSignedAt  DateTime? @map("application_signed_at")
  deliveryMethod       String    @default("electronic") @map("delivery_method")
  sanctionsScreenClear Boolean?  @map("sanctions_screen_clear")
  ssnValidatedWithSsa  Boolean?  @map("ssn_validated_with_ssa")
  fraudReviewComplete  Boolean   @default(false) @map("fraud_review_complete")

  // Existing loan, on a refinance.
  existingServicer       String?  @map("existing_servicer")
  existingLoanNumber     String?  @map("existing_loan_number")
  existingBalance        Decimal? @map("existing_balance") @db.Decimal(14, 2)
  existingRate           Decimal? @map("existing_rate") @db.Decimal(6, 4)
  existingMonthlyPayment Decimal? @map("existing_monthly_payment") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The identity session started to PREFILL screen 2, before any borrower
  /// row exists.
  ///
  /// A hosted vendor cannot read a document synchronously: it sends the person
  /// to its own site and answers "pending" until they finish. So the id has to
  /// outlive the request that created it, and there is nowhere else to put it —
  /// Borrower requires a name, a date of birth and an SSN, which are the very
  /// things this session exists to discover, so a placeholder row would mean
  /// inventing them.
  ///
  /// Scoping, not convenience: the completion route reads the id from HERE and
  /// ignores whatever the client sends, so one file owner cannot read another
  /// verification's outputs by guessing a session id.
  identityPrefillVerificationId String? @map("identity_prefill_verification_id")

  /// The credit request this file became, once one exists. Optional because a
  /// file exists from the first keystroke on screen 1 and the legacy demo
  /// files never had one.
  application Application?

  borrowers     Borrower[]
  consents      Consent[]
  links         ConnectorLink[]
  vendorTokens  VendorToken[]
  snapshots     ConnectorSnapshot[]
  documents     Document[]
  disclosures   Disclosure[]
  decisions     Decision[]
  conditions    LoanCondition[]
  events        FileEvent[]
  incomeSources IncomeSource[]
  employments   Employment[]

  @@index([stage])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([isDemo])
  @@map("loan_files")
}

// ─── PEOPLE ─────────────────────────────────────────────────────────────────

model Borrower {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  /// The person. Required: a borrower row is a per-application record ABOUT a
  /// party, and it holds nothing that identifies anyone. Name, date of birth,
  /// the SSN vault handle, contact details, address, marital status,
  /// citizenship, language, military service and first-time-buyer status are
  /// all facts on the party — written by screen 2, read by the projection,
  /// and never duplicated here. The columns that used to hold them were
  /// dropped once every existing row had been backfilled into facts.
  partyId String @map("party_id") @db.Uuid
  party   Party  @relation("BorrowerParty", fields: [partyId], references: [id], onDelete: Cascade)

  /// Display only. The vault handle — the reference the credit pull, the
  /// SSA-89 and the 4506-C exchange for the number — is the `ssn_token` fact.
  /// A migration that adds a plaintext SSN column to this table is the single
  /// change most likely to turn a prototype into a breach.
  ssnLast4 String @map("ssn_last4") @db.VarChar(4)

  /// Identity verified against a government document, rather than typed.
  /// Per vendor session, so per application. Null means never attempted.
  identityVerifiedAt         DateTime? @map("identity_verified_at")
  identityVerificationId     String?   @map("identity_verification_id")
  identityVerificationStatus String?   @map("identity_verification_status")

  /// Whether the spouse must sign depends on the property's state and this
  /// loan, not on the person — a community-property question per application.
  nonBorrowingSpouseName              String? @map("non_borrowing_spouse_name")
  nonBorrowingSpouseSignatureRequired Boolean @default(false) @map("non_borrowing_spouse_signature_required")

  /// URLA Section 7. Collected PER APPLICATION by law (HMDA), so never a fact
  /// on the party.
  demographics Json?

  /// What they pay NOW, on THIS file. Situational, not identity.
  ///
  /// DERIVED, and nullable, and both halves are the same change. `du_residences`
  /// is the source of truth for the housing basis and the rent; these two are
  /// the copies the requirements engine and the projection read. The column was
  /// `String @default("rent")` NOT NULL, which meant every borrower row carried a
  /// statement about their own housing that nobody had been asked for, bound for
  /// a federal submission — and a writer that merely stopped naming the column
  /// would still have got `'rent'` from Postgres, so the default and the NOT NULL
  /// had to go in the same commit that stopped writing it.
  ///
  /// NULL means nobody has been asked yet. It is not "rent", and the engine is
  /// told the difference: `renter_limited_mortgage_history` answers null on a
  /// null basis rather than assuming a renter.
  currentHousing String?  @map("current_housing")
  monthlyRent    Decimal? @map("monthly_rent") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consents Consent[]

  @@index([loanFileId])
  @@index([partyId])
  @@map("borrowers")
}

/// A consent, and the evidence it was given. APP-005 is the one that gates
/// every connector call in the product.
model Consent {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)
  borrowerId String   @map("borrower_id") @db.Uuid
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  kind       String
  grantedAt  DateTime  @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  envelopeId String?   @map("envelope_id")
  ipAddress  String    @map("ip_address")
  userAgent  String    @map("user_agent")

  @@index([loanFileId, kind])
  @@map("consents")
}

// ─── CONNECTORS ─────────────────────────────────────────────────────────────

/// A live connection to a data source. `persistentMonitoringEnabled` is what
/// screen 9 turns on, and it is the switch the whole refinance-monitoring
/// product depends on. V1 records it; it does not yet act on it.

/// Bearer credentials a vendor handed back, encrypted at rest.
///
/// A Plaid access token is not a session id. It reads a named person's bank
/// transactions for as long as the item lives, and it does so without any
/// further interaction from them — which makes a leaked row here worse than a
/// leaked session cookie, not better. AES-256-GCM under `VENDOR_TOKEN_KEY`,
/// which lives in Secret Manager and is not in the database.
///
/// Unlike `connector_snapshots` and `decisions`, this is deliberately NOT
/// append-only: a re-link replaces the credential rather than accumulating
/// live ones. Old bearer tokens are a liability, not history.
model VendorToken {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  /// Namespaced by vendor, e.g. "plaid.access_token".
  key String

  /// base64(iv):base64(authTag):base64(ciphertext)
  ciphertext String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loanFileId, key])
  @@map("vendor_tokens")
}

model ConnectorLink {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  kind     String
  provider String
  status   String @default("active")

  linkedAt                    DateTime @map("linked_at")
  lastSyncedAt                DateTime @map("last_synced_at")
  persistentMonitoringEnabled Boolean  @default(false) @map("persistent_monitoring_enabled")

  /// Set when monitoring is on. Null means nothing is scheduled.
  nextSyncDueAt DateTime? @map("next_sync_due_at")

  @@unique([loanFileId, kind])
  @@index([persistentMonitoringEnabled, nextSyncDueAt])
  @@map("connector_links")
}

/// Verbatim vendor output. Append-only: a re-pull writes a NEW row.
///
/// Keeping every pull rather than the latest is what makes the monitoring
/// product possible at all — "your situation changed" is a diff between two
/// snapshots, and you cannot diff against a row you overwrote.
model ConnectorSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  /// Whose report this is. Required for the person-keyed kinds — credit, bank,
  /// payroll, irs, sanctions — and forbidden for the address-keyed ones, which
  /// run on screen 1 before a borrower exists. The database enforces both, and
  /// refuses a kind it has never heard of rather than defaulting it to nobody.
  partyId String? @map("party_id") @db.Uuid
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  kind        String
  provider    String
  externalId  String   @map("external_id")
  /// The domain-shaped payload. Vendor-native JSON stays in `raw`.
  payload     Json
  raw         Json?
  retrievedAt DateTime @map("retrieved_at")

  employersFirstSeen  Employer[]     @relation("EmployerFirstSeen")
  incomeFirstSeen     IncomeSource[] @relation("IncomeFirstSeen")
  incomeLastSeen      IncomeSource[] @relation("IncomeLastSeen")
  incomeRetiredBy     IncomeSource[] @relation("IncomeRetiredBy")
  employmentFirstSeen Employment[]   @relation("EmploymentFirstSeen")
  employmentLastSeen  Employment[]   @relation("EmploymentLastSeen")
  employmentRetiredBy Employment[]   @relation("EmploymentRetiredBy")
  assetSource         DuAsset[]      @relation("DuAssetSource")
  assetFirstSeen      DuAsset[]      @relation("DuAssetFirstSeen")
  assetLastSeen       DuAsset[]      @relation("DuAssetLastSeen")
  assetRetiredBy      DuAsset[]      @relation("DuAssetRetiredBy")
  liabilitySource     DuLiability[]  @relation("DuLiabilitySource")
  liabilityFirstSeen  DuLiability[]  @relation("DuLiabilityFirstSeen")
  liabilityLastSeen   DuLiability[]  @relation("DuLiabilityLastSeen")
  liabilityRetiredBy  DuLiability[]  @relation("DuLiabilityRetiredBy")

  @@index([loanFileId, kind, retrievedAt])
  /// The person-to-reports direction, which is what a submission assembles from.
  @@index([partyId], map: "connector_snapshots_party")
  /// Joining a row to its snapshot uses the primary key. This answers the other
  /// question — which numbers came out of vendor report X — which is the one an
  /// underwriter asks when a vendor issues a correction.
  @@index([externalId], map: "connector_snapshots_external_id")
  @@map("connector_snapshots")
}

// ─── DERIVED INCOME AND EMPLOYMENT ──────────────────────────────────────────

/// An employer, as two pulls recognize it across a re-pull.
///
/// Keyed to the party rather than to the file: an employer is a thing in the
/// world, and the same person's second application is about the same job.
/// Income and employment rows stay per file because continuance is a judgment
/// about one loan; only the employer they point at is shared.
model Employer {
  id      String @id @default(uuid()) @db.Uuid
  partyId String @map("party_id") @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// What two pulls compare to decide they mean the same employer:
  /// `ein:<digits>` when a vendor gave one, `name:<normalized>` otherwise.
  identityKey String @map("identity_key")
  /// Which rule produced the key, so a row derived from a bank memo is
  /// identifiable as one without re-deriving it. "ein" or "name".
  derivedFrom String @map("derived_from")
  /// The `name:` key this employer would have had with no EIN in hand, written
  /// once and never rewritten. Matching runs in both directions across the
  /// promotion: payroll moves `identityKey` to the `ein:` form, and the bank
  /// pull that follows derives only a name, which without this column would
  /// find nothing and open a second row for one job.
  nameKey     String @map("name_key")

  ein         String?
  displayName String  @map("display_name")

  /// The vendor report this employer was first seen in. Null on a row written
  /// before provenance was kept, and null again if that report is ever erased.
  firstSeenSnapshotId String?            @map("first_seen_snapshot_id") @db.Uuid
  firstSeenSnapshot   ConnectorSnapshot? @relation("EmployerFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomeSources IncomeSource[]
  employments   Employment[]

  @@unique([partyId, identityKey], map: "employers_party_identity_key")
  @@index([partyId], map: "employers_party")
  /// Not unique. Two EINs filed under one trade name are two employers that
  /// share a name key, and a unique index would make the pull reporting the
  /// second one fail rather than record it.
  @@index([partyId, nameKey], map: "employers_party_name")
  @@map("employers")
}

/// Income as finally determined, which is not the same as income a connector
/// reported. The reconciliation between the two is the underwriting.
model IncomeSource {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)
  /// Whose income this is. The row is per file, but the person it is about is
  /// the party — which is what lets a re-pull recognize the same person's
  /// income, and what keeps a co-borrower's pull off this row.
  partyId    String   @map("party_id") @db.Uuid
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// What a re-pull matches on. Derived, because no vendor gives us a stable
  /// per-item identifier; see services/employer-identity.ts for the rule and
  /// for the ways it collides. Rows written before matching existed carry a
  /// `legacy:` key nothing will ever match.
  identityKey String    @map("identity_key")
  /// RESTRICT, not SET NULL: nulling this from inside somebody else's DELETE
  /// would break `employment_income = (employer_id IS NOT NULL)`. The way past
  /// it is to repoint this column and `employments.employer_id` onto the
  /// surviving employer in one transaction and then delete the loser —
  /// retiring the income does not help, because RESTRICT looks for the row and
  /// `retiredAt` does not clear this column.
  employerId  String?   @map("employer_id") @db.Uuid
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Restrict)

  /// EmploymentIncomeIndicator. CURRENT_INCOME_ITEM is two kinds of thing under
  /// one element name, and only the employment kind is associated with an
  /// employer — so this is true exactly when `employerId` is set, and the
  /// database holds the two to each other.
  employmentIncome Boolean @default(false) @map("employment_income")

  type                   String
  monthlyAmount          Decimal   @map("monthly_amount") @db.Decimal(12, 2)
  historyMonths          Int       @map("history_months")
  continuanceEndDate     DateTime? @map("continuance_end_date") @db.Date
  /// Null until INC-027 runs. Null is not false.
  continuanceEstablished Boolean?  @map("continuance_established")
  evidenceDocumentIds    String[]  @default([]) @map("evidence_document_ids")

  /// When we first saw this income, and which report the numbers on it come
  /// from now. Both are needed: one would answer half the question.
  firstSeenSnapshotId String?            @map("first_seen_snapshot_id") @db.Uuid
  firstSeenSnapshot   ConnectorSnapshot? @relation("IncomeFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: SetNull)
  lastSeenSnapshotId  String?            @map("last_seen_snapshot_id") @db.Uuid
  lastSeenSnapshot    ConnectorSnapshot? @relation("IncomeLastSeen", fields: [lastSeenSnapshotId], references: [id], onDelete: SetNull)

  /// Set when a pull stops reporting this income. Superseded rather than
  /// deleted, because you cannot diff against a row you deleted — and the
  /// projection reads only live rows.
  retiredAt           DateTime?          @map("retired_at")
  retiredBySnapshotId String?            @map("retired_by_snapshot_id") @db.Uuid
  retiredBySnapshot   ConnectorSnapshot? @relation("IncomeRetiredBy", fields: [retiredBySnapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Spans retired rows on purpose: an income that goes away and comes back is
  /// one income, so a later pull revives the row rather than inserting a twin.
  @@unique([loanFileId, partyId, identityKey], map: "income_sources_file_party_identity_key")
  @@index([loanFileId])
  @@index([partyId], map: "income_sources_party")
  @@index([employerId], map: "income_sources_employer")
  @@map("income_sources")
}

model Employment {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)
  partyId    String   @map("party_id") @db.Uuid
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// An employment's identity IS its employer, so it needs no key of its own.
  /// Null on a row written before matching existed, and NULLs are distinct in
  /// a Postgres unique index, so such a row conflicts with nothing while it
  /// waits to be retired.
  employerId String?   @map("employer_id") @db.Uuid
  employer   Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  employerName       String    @map("employer_name")
  employerEin        String?   @map("employer_ein")
  position           String
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  status             String
  isMilitary         Boolean   @default(false) @map("is_military")
  verificationMethod String    @map("verification_method")

  firstSeenSnapshotId String?            @map("first_seen_snapshot_id") @db.Uuid
  firstSeenSnapshot   ConnectorSnapshot? @relation("EmploymentFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: SetNull)
  lastSeenSnapshotId  String?            @map("last_seen_snapshot_id") @db.Uuid
  lastSeenSnapshot    ConnectorSnapshot? @relation("EmploymentLastSeen", fields: [lastSeenSnapshotId], references: [id], onDelete: SetNull)

  retiredAt           DateTime?          @map("retired_at")
  retiredBySnapshotId String?            @map("retired_by_snapshot_id") @db.Uuid
  retiredBySnapshot   ConnectorSnapshot? @relation("EmploymentRetiredBy", fields: [retiredBySnapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loanFileId, partyId, employerId], map: "employments_file_party_employer_key")
  @@index([loanFileId])
  @@index([partyId], map: "employments_party")
  @@index([employerId], map: "employments_employer")
  @@map("employments")
}

// ─── DOCUMENTS AND DISCLOSURES ──────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  filename               String
  contentType            String   @map("content_type")
  bytes                  Int
  storageUri             String   @map("storage_uri")
  /// Which requirement the borrower was asked to satisfy with this file.
  satisfiesRequirementId String   @map("satisfies_requirement_id")
  uploadedAt             DateTime @default(now()) @map("uploaded_at")

  @@index([loanFileId, satisfiesRequirementId])
  @@map("documents")
}

/// Delivery of a disclosure, with the timestamp that proves the clock was met.
model Disclosure {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  kind        String
  deliveredAt DateTime @map("delivered_at")
  method      String
  documentId  String   @map("document_id")

  @@index([loanFileId, kind])
  @@map("disclosures")
}

// ─── DECISION ───────────────────────────────────────────────────────────────

/// A decision is a SNAPSHOT, not a mutable row. Every recomputation appends.
///
/// This is what makes the monitoring loop expressible: "your options changed"
/// is decision N against decision N-1. It is also the only honest way to store
/// a verdict that was produced by an engine whose version can change.
model Decision {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  outcome    String
  computedAt DateTime @map("computed_at")

  /// "shadow" until a real DU or LPA integration exists. Never inferred.
  ausEngine         String @map("aus_engine")
  ausEngineVersion  String @map("aus_engine_version")
  ausCasefileId     String @map("aus_casefile_id")
  ausRecommendation String @map("aus_recommendation")
  ausFindings       Json   @map("aus_findings")

  ratios               Json
  reserves             Json
  compliance           Json
  pricing              Json
  /// The full audit trail behind every number above (screen 8's "show the
  /// reasoning"). Stored rather than recomputed, because the guidelines
  /// constants change and a re-derivation would silently rewrite history.
  derivations          Json
  adverseActionReasons String[] @default([]) @map("adverse_action_reasons")

  @@index([loanFileId, computedAt])
  @@map("decisions")
}

model LoanCondition {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  requirementId String    @map("requirement_id")
  description   String
  status        String    @default("open")
  owner         String
  issuedAt      DateTime  @map("issued_at")
  clearedAt     DateTime? @map("cleared_at")
  documentIds   String[]  @default([]) @map("document_ids")

  @@index([loanFileId, status])
  @@map("loan_conditions")
}

// ─── EVENTS ─────────────────────────────────────────────────────────────────

/// Append-only event stream for the file.
///
/// V1 writes it for the audit trail. It is also the substrate the realtime
/// re-evaluation loop will read from, which is why it exists before that loop
/// does — the events a monitoring product needs are the ones that happened
/// before anybody built it.
model FileEvent {
  id         String   @id @default(uuid()) @db.Uuid
  loanFileId String   @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  kind          String
  /// The requirement this event advanced, where it advanced one.
  requirementId String?  @map("requirement_id")
  payload       Json
  occurredAt    DateTime @default(now()) @map("occurred_at")
  /// Who caused it: "borrower", "system", or a connector provider name.
  actor         String

  @@index([loanFileId, occurredAt])
  @@index([kind, occurredAt])
  @@map("file_events")
}

// ─── THE RELATIONSHIP LAYER ─────────────────────────────────────────────────
//
// The first slice of the model in `docs/states.md`. It lands ALONGSIDE the
// loan-file tables above rather than replacing them: nothing here is wired into
// a route yet, and the borrower screens keep running on `loan_files` until the
// application layer exists to move them.
//
// The rule that makes this worth having is that a Party outlives every
// application. A Grander portfolio member has a mortgage and no application; a
// returning borrower's second file must reuse what we already verified rather
// than re-scan and re-charge. Neither is expressible while identity is a
// cascade child of a loan file.

/// Whether a fact is about a person, a building, or something else.
///
/// A plain string would do, and would let a typo create a whole parallel
/// universe of facts nobody queries.
enum FactSubjectType {
  PARTY
  PROPERTY
  LOAN
}

/// Where an assertion came from. Not how much we trust it — that is `confidence`.
enum FactSourceKind {
  SELF_ATTESTED
  STAFF_ENTERED
  VENDOR_RETRIEVED
  PUBLIC_RECORD
  DOCUMENT_EXTRACTED
  PARTNER_SHARED
  AI_INFERRED
  DERIVED
}

/// How well we know something. ORDERED, weakest first — Postgres compares enum
/// values by declaration order, so `confidence >= 'CORROBORATED'` is a real
/// query and the ladder is a property of the type rather than a lookup table.
///
/// The distinction that earns its keep is VERIFIED vs everything below it.
/// Plaid Assets and Plaid CRA return identical bytes from the same bank login,
/// and only CRA carries FCRA consumer-report status — same data, different
/// tier, and the requirement turns on the tier, not the bytes.
enum ConfidenceTier {
  ATTESTED
  UNVERIFIED
  INFERRED
  ESTIMATED
  CORROBORATED
  VERIFIED
  VALIDATED_D1C
}

enum PrincipalKind {
  BORROWER
  STAFF
  SERVICE
  PARTNER
  AI_AGENT
}

enum PartyKind {
  PERSON
  ENTITY
}

/// How far along a party is in becoming a person who has agreed to be here.
///
/// PROVISIONAL is the Grander import: a record about somebody who has never
/// contacted us. It is deliberately a state rather than a boolean, because the
/// things you may do with a provisional party are narrower than the things you
/// may do with a claimed one, and that is a rule worth being able to name.
///
/// Two triggers say what "narrower" means, so it is not a matter of every
/// writer remembering. `authorizations_require_a_claimed_party` refuses a
/// permission held by somebody who has never contacted us, which is what puts
/// an imported record out of reach of every connector at once;
/// `parties_claim_status_moves_forward` refuses an UPDATE that would declare
/// one claimed, and requires a MERGED party to name a survivor and then keep
/// the one it named.
enum PartyClaimStatus {
  PROVISIONAL
  CLAIM_PENDING
  CLAIMED
  MERGED
}

/// A durable person or legal entity. Trusts and LLCs hold investment property,
/// which is why this is not called `Person`.
///
/// It carries NO name, date of birth or SSN column. Those are facts, with a
/// source and a time — because "what did the borrower tell us, and when" is the
/// axis an ECOA complaint runs along, and a mutable column cannot answer it.
model Party {
  id          String           @id @default(uuid()) @db.Uuid
  kind        PartyKind        @default(PERSON)
  claimStatus PartyClaimStatus @default(PROVISIONAL) @map("claim_status")

  /// Set when a duplicate is folded into another party. The row stays, so a
  /// fact asserted against the old id is still reachable.
  mergedIntoPartyId String? @map("merged_into_party_id") @db.Uuid
  mergedInto        Party?  @relation("PartyMerge", fields: [mergedIntoPartyId], references: [id], onDelete: SetNull)
  mergedFrom        Party[] @relation("PartyMerge")

  /// How we first heard of them: "self_signup", "grander_import", a partner name.
  /// Free text on purpose — a new partner should not need a migration.
  sourceFirstSeen String? @map("source_first_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  facts              Fact[]
  principals         Principal[]
  authorizations     Authorization[]
  applications       ApplicationParty[]
  loans              LoanParty[]
  users              User[]              @relation("UserParty")
  borrowerRows       Borrower[]          @relation("BorrowerParty")
  employers          Employer[]
  incomeSources      IncomeSource[]
  employments        Employment[]
  connectorSnapshots ConnectorSnapshot[]

  @@index([claimStatus])
  @@index([mergedIntoPartyId])
  @@map("parties")
}

/// Any actor that can assert something: a borrower, a member of staff, a
/// scheduled job, a partner system, or an AI agent.
///
/// This replaces the prototype's free-string `FileEvent.actor`, which is only
/// ever "borrower", "system", or a provider name — and which therefore cannot
/// answer "which agent decided this". An AI model upgrade is a NEW principal
/// row, so `model_version` resolves to the thing that actually ran.
model Principal {
  id      String        @id @default(uuid()) @db.Uuid
  kind    PrincipalKind
  /// Human-readable handle: an email, a job name, a partner slug, a model alias.
  subject String

  /// Set only for BORROWER principals.
  partyId String? @map("party_id") @db.Uuid
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  modelId      String? @map("model_id")
  modelVersion String? @map("model_version")

  deprovisionedAt DateTime? @map("deprovisioned_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  assertedFacts         Fact[]                  @relation("FactAssertedBy")
  assertedDeclarations  DuDeclaration[]         @relation("DeclarationAssertedBy")
  revokedAuthorizations Authorization[]         @relation("AuthorizationRevokedBy")
  transitionsCaused     ApplicationTransition[] @relation("TransitionActor")
  loanMovesCaused       LoanTransition[]        @relation("LoanTransitionActor")

  @@unique([kind, subject])
  @@index([partyId])
  @@map("principals")
}

/// The append-only provenance ledger for regulated attributes.
///
/// One row per assertion. Legal name, date of birth, citizenship, marital
/// status, military service, income, employers, credit scores — anything a
/// requirement's applicability or evidence path might read, and that has no
/// lifecycle of its own beyond being asserted, superseded or expiring.
///
/// Anything WITH a lifecycle of its own gets a table instead: a certified flood
/// determination has a certificate, a life-of-loan monitoring duty and a
/// borrower notice; an appraisal has an order, a licence and a 120-day
/// validity. Flattening those into key-value rows loses the structure the
/// obligation attaches to.
///
/// APPEND-ONLY, and enforced by a trigger rather than by convention — see the
/// migration. The only columns anything may update are `superseded_by_id`,
/// `retracted_at` and `retraction_reason`.
model Fact {
  id String @id @default(uuid()) @db.Uuid

  subjectType FactSubjectType @map("subject_type")
  subjectId   String          @map("subject_id") @db.Uuid
  /// Present when the subject is a party, so the FK can do its job. Null for a
  /// property or loan subject, which do not have tables yet.
  party       Party?          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId     String?         @map("party_id") @db.Uuid

  /// What is being asserted: "legal_name", "date_of_birth", "annual_income".
  predicate  String
  /// Discriminates repeated facts of the same predicate — an employer id, an
  /// account id. Empty string for a singleton, never null, so the uniqueness
  /// and ordering indexes do not have to reason about three-valued logic.
  subjectKey String @default("") @map("subject_key")

  value Json

  sourceKind FactSourceKind @map("source_kind")
  confidence ConfidenceTier

  assertedByPrincipalId String    @map("asserted_by_principal_id") @db.Uuid
  assertedBy            Principal @relation("FactAssertedBy", fields: [assertedByPrincipalId], references: [id])

  /// When the thing was true in the world, versus when we wrote it down. A
  /// backdated correction is a new row with an earlier `observed_at` and a
  /// later `recorded_at`, never an edit.
  observedAt DateTime @map("observed_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  /// When this assertion stops being usable. Null means it does not expire on
  /// its own — a filed tax year never goes stale; a credit pull does.
  expiresAt DateTime? @map("expires_at")

  /// Points at the row that replaced this one.
  supersededById String? @unique @map("superseded_by_id") @db.Uuid
  supersededBy   Fact?   @relation("FactSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Fact?   @relation("FactSupersession")

  /// Withdrawn rather than replaced — the borrower says they never said it.
  retractedAt      DateTime? @map("retracted_at")
  retractionReason String?   @map("retraction_reason")

  pins ApplicationEvidenceLink[]

  @@index([subjectType, subjectId, predicate, subjectKey, observedAt(sort: Desc)])
  @@index([partyId])
  @@index([assertedByPrincipalId])
  @@index([expiresAt])
  @@map("facts")
}

/// What a grant permits. Named for the legal basis, not for the screen that
/// collected it.
///
/// The prototype's `Consent.kind` is a free string with five values and no
/// scope: one "verification_authorization" covers every pull, of every data
/// category, from every vendor, forever. These are narrower on purpose —
/// pulling a tax transcript and re-pulling a bank feed for monthly monitoring
/// are different permissions with different lifetimes, and a borrower who
/// agreed to one has not agreed to the other.
enum AuthorizationPurpose {
  /// FCRA 604(a)(2) written instruction of the consumer. The origination pull.
  FCRA_WRITTEN_INSTRUCTION
  /// FCRA 604(a)(3)(F)(ii) account review. What monthly monitoring runs under,
  /// and NOT what an origination authorization covers.
  FCRA_ACCOUNT_REVIEW
  FCRA_PRESCREEN
  IRS_4506C
  SSA_89
  BIOMETRIC_IDV
  ELECTRONIC_DELIVERY
  PARTNER_DATA_SHARE
  MARKETING_CONTACT
}

/// What may be retrieved under a grant.
///
/// Only person-keyed categories appear here. An address lookup — assessor
/// record, AVM, flood — is keyed on a building and needs no permission from
/// anybody, which is why screen 1 can run before any authorization exists.
enum DataCategory {
  CREDIT_REPORT
  BANK_TRANSACTIONS
  PAYROLL_INCOME
  TAX_TRANSCRIPT
  IDENTITY_DOCUMENT
  SANCTIONS_SCREENING
  /// A lien search names an owner, so it is person-keyed even though the query
  /// goes in by parcel number. The assessor record, the AVM and the flood
  /// determination for the same parcel are not — those need nobody's
  /// permission, which is why screen 1 runs before any authorization exists.
  PUBLIC_RECORD_LIENS
}

/// A scoped, expiring, revocable grant by one party.
///
/// Three differences from the `Consent` row it replaces, each of which is a
/// defect it closes. It names a PARTY rather than a file, so one borrower's
/// signature cannot authorize a pull about their co-borrower. It carries data
/// categories, so a bank authorization is not also a tax-transcript
/// authorization. And `expires_at` is NOT NULL, because a permission with no
/// end is one nobody ever has to look at again.
model Authorization {
  id      String @id @default(uuid()) @db.Uuid
  partyId String @map("party_id") @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  purpose        AuthorizationPurpose
  dataCategories DataCategory[]       @map("data_categories")

  /// Who the data may be shared with or retrieved from. Empty means the grant
  /// names no counterparty and the caller must not infer one.
  counterparties String[] @default([]) @map("counterparties")

  grantedAt DateTime @map("granted_at")
  /// NOT NULL on purpose. Origination grants run ~120 days; an account-review
  /// grant for monitoring is renewable and measured in months.
  expiresAt DateTime @map("expires_at")

  revokedAt            DateTime?  @map("revoked_at")
  revokedByPrincipalId String?    @map("revoked_by_principal_id") @db.Uuid
  revokedBy            Principal? @relation("AuthorizationRevokedBy", fields: [revokedByPrincipalId], references: [id])
  revocationReason     String?    @map("revocation_reason")

  /// Hash of the exact words shown when it was granted. Content-addressed, so
  /// "what did they actually agree to" survives a copy edit to the template.
  disclosureTextHash  String? @map("disclosure_text_hash")
  /// Set once signing is wired. Null means the grant was recorded without an
  /// executed document behind it, which is a fact worth being able to query.
  signatureEnvelopeId String? @map("signature_envelope_id")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  pins ApplicationEvidenceLink[]

  @@index([partyId, purpose])
  @@index([expiresAt])
  @@map("authorizations")
}

// ─── THE APPLICATION LAYER ──────────────────────────────────────────────────

/// Nineteen states, mirroring packages/shared/src/application-machine.ts.
///
/// The machine there is the authority on which moves are legal; this enum only
/// says which values may be stored. A test asserts the two agree, because a
/// state added to one and not the other is a file that can enter a state
/// nothing knows how to render.
enum ApplicationState {
  DRAFT
  INTAKE_RECEIVED
  IN_PROCESSING
  AWAITING_BORROWER
  SUSPENDED
  IN_UNDERWRITING
  COUNTEROFFER_OUTSTANDING
  CONDITIONALLY_APPROVED
  APPROVED
  CLEAR_TO_CLOSE
  CLOSING
  RESCISSION_PENDING
  FUNDED
  ADVERSE_ACTION_PENDING
  DENIED
  INCOMPLETE_CLOSED
  WITHDRAWN
  CANCELED
  EXPIRED
}

enum ApplicationPartyRole {
  PRIMARY_BORROWER
  CO_BORROWER
  NON_OCCUPANT_CO_BORROWER
  NON_BORROWING_SPOUSE
  GUARANTOR
}

/// A credit request. Transient — it starts, it ends, and it is never reopened.
///
/// It holds no borrower fields, no property columns and no income. Those are
/// facts on a party, and an application BORROWS them. What lives here is the
/// request itself and where it stands.
///
/// `status` is written ONLY by the transition service. Two database triggers
/// enforce that rather than trusting it: one refuses a status change that does
/// not also advance `statusSeq`, and a deferred constraint trigger refuses to
/// let a transaction commit if it moved the status without writing the matching
/// ledger row. A bare `prisma.application.update({ data: { status } })` fails.
model Application {
  id String @id @default(uuid()) @db.Uuid

  /// The file this application was born from. NOT NULL and UNIQUE: one credit
  /// request per file, and an application cannot outlive the file — which is
  /// what makes "we remove your data for good" include the application and
  /// its ledger. Leaves with loan_files when the strangler finishes.
  loanFileId String   @unique @map("loan_file_id") @db.Uuid
  loanFile   LoanFile @relation(fields: [loanFileId], references: [id], onDelete: Cascade)

  /// The identifier every resubmission of this loan carries. Desktop
  /// Underwriter recognizes a resubmission by it, and a fresh one opens a new
  /// case — so it is minted when the request is born and never again. UNIQUE:
  /// two credit requests sharing one is the same confusion reversed.
  ausCasefileId String @unique @map("aus_casefile_id")

  /// The identifier DESKTOP UNDERWRITER minted, which is a different thing.
  /// `AutomatedUnderwritingCaseIdentifier` is a String 30 and DU chooses it, so
  /// it is null until a submission has been answered — and write-once after,
  /// because a resubmission carries the case DU named and a new case is a new
  /// application. `ausCasefileId` above is ours and is never sent as this one:
  /// a 36-character UUID fits neither this field nor `LenderLoan`, a String 15.
  duCasefileId String? @unique @map("du_casefile_id") @db.VarChar(30)

  status          ApplicationState @default(DRAFT)
  /// Increments on every transition. The ledger row for a move carries the same
  /// number, and `(application_id, seq)` is unique — so two writers racing is an
  /// insert conflict rather than a lost update.
  statusSeq       Int              @default(0) @map("status_seq")
  /// When the file entered its current state. What an ops queue sorts on, and
  /// the reason a stored state beats a derived one: you cannot age a function.
  statusEnteredAt DateTime         @default(now()) @map("status_entered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parties         ApplicationParty[]
  transitions     ApplicationTransition[]
  scenarios       LoanScenario[]
  pins            ApplicationEvidenceLink[]
  clocks          RegulatoryClock[]
  assets          DuAsset[]
  ownedProperties DuOwnedProperty[]
  liabilities     DuLiability[]
  expenses        DuExpense[]
  jointCredit     DuJointCreditReportLink[]
  /// The mortgage this request became, if it funded. Not a cascade in either
  /// direction: the loan names the application, and survives it.
  loan            Loan?

  /// The queue query this exists to make cheap: everything in one state,
  /// oldest first.
  @@index([status, statusEnteredAt])
  @@map("applications")
}

/// Which parties are on an application, and in what capacity.
///
/// Plural from the start. The prototype reads `borrowers[0]` in a dozen places,
/// and every one of them is a co-borrower quietly ignored — which is also how
/// one person's signature came to authorize a pull about somebody else.
model ApplicationParty {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  partyId       String      @map("party_id") @db.Uuid
  party         Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)

  role ApplicationPartyRole

  /// DU Borrower 1 through 4. A POSITION in one submitted document, not an
  /// identity — `id` is the identity — because DU conveys the position by
  /// document order and label ordinal and states it in no element. Null for a
  /// non-borrowing spouse or a guarantor, who emit no `BORROWER` at all, and a
  /// CHECK ties the two directions together: a borrowing role without a number
  /// is a borrower with no position in the document.
  ///
  /// Allocated by `ensureApplicationParty` as the SMALLEST UNUSED number, under
  /// a lock on the application row. A freed ordinal is refilled and the
  /// survivors are never renumbered: a borrower who was 2 stays 2.
  borrowerOrdinal Int? @map("borrower_ordinal")

  createdAt DateTime @default(now()) @map("created_at")

  declaration             DuDeclaration?
  residences              DuResidence[]
  /// The arcs. Cascading, so dropping a borrower removes every arc naming them
  /// rather than leaving one pointed at a ROLE the document no longer emits.
  assetLinks              DuAssetParty[]
  liabilityLinks          DuLiabilityParty[]
  expenseLinks            DuExpenseParty[]
  /// This edge as an additional borrower on a joint credit report, and as the
  /// primary of one. Never both on an application: a trigger says so.
  jointCreditAsAdditional DuJointCreditReportLink[] @relation("JointCreditFrom")
  jointCreditAsPrimary    DuJointCreditReportLink[] @relation("JointCreditTo")

  @@unique([applicationId, partyId])
  @@index([partyId])
  @@map("application_parties")
}

/// Every move, in order, with its cause. Append-only.
///
/// A transition is itself a regulated act — the ECOA clock runs from the
/// decision, the Reg B window from the notice, rescission from consummation —
/// so a state with no recorded timestamp, actor and reason cannot lawfully
/// start a clock. This is also what makes "what state was this file in on 14
/// March 2027" answerable after a deploy that changed the code.
model ApplicationTransition {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Matches the application's `statusSeq` after the move. Gapless from 1.
  seq Int

  fromState ApplicationState? @map("from_state")
  toState   ApplicationState  @map("to_state")
  event     String

  /// Who caused it. An AI reviewer resolves to a specific model version here,
  /// which is what makes "which agent decided this" answerable.
  actorPrincipalId String    @map("actor_principal_id") @db.Uuid
  actor            Principal @relation("TransitionActor", fields: [actorPrincipalId], references: [id])

  /// A code from a closed set, not free text — this is what an ops report
  /// groups by, and what a compliance review reads.
  reasonCode String? @map("reason_code")
  /// What produced it: a decision run, a delivered notice, a failed retrieval.
  causedBy   String? @map("caused_by")

  /// Bitemporal. A backdated correction is a NEW row with an earlier
  /// `occurredAt` and a later `recordedAt`, never an edit to this one.
  occurredAt DateTime @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@unique([applicationId, seq])
  @@index([applicationId, occurredAt])
  @@map("application_transitions")
}

// ─── SCENARIOS, PINS, AND CLOCKS ────────────────────────────────────────────

enum ScenarioObjective {
  PURCHASE
  RATE_TERM_REFINANCE
  CASH_OUT_REFINANCE
  HELOC_DRAW
  CLOSED_END_SECOND
}

enum LienPosition {
  FIRST
  SECOND
  SUBORDINATE_HELOC
}

enum Occupancy {
  PRIMARY_RESIDENCE
  SECOND_HOME
  INVESTMENT
}

enum ScenarioOrigin {
  BORROWER
  COUNTEROFFER
  REPRICING
  STAFF
  AI_SUGGESTED
}

/// A versioned, immutable set of proposed terms.
///
/// A counteroffer is a NEW scenario, not a mutation, and so is a borrower
/// changing their mind after the file is being worked on. The change is never
/// lost and never silently applied to something somebody is deciding on. A
/// trigger refuses UPDATE on anything but the two supersession columns, and a
/// partial unique index holds exactly one active scenario per application.
///
/// Money is bigint minor units and the rate is integer basis points. The loan
/// file stores Decimal and converts to a double at the projection boundary,
/// then writes float results into the audit trail; that stops here.
///
/// BRIDGE: `propertyAddress` and `valueEstimateCents` sit on the scenario for
/// now, because there is no Property object yet. They are two of TRID's six
/// pieces and the receipt trigger reads them from here. When `properties`
/// lands they move, and the trigger's predicate changes with them.
model LoanScenario {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// 1, 2, 3… per application. The version.
  seq Int

  objective    ScenarioObjective
  lienPosition LienPosition      @default(FIRST) @map("lien_position")
  occupancy    Occupancy

  loanAmountCents    BigInt  @map("loan_amount_cents")
  downPaymentCents   BigInt  @default(0) @map("down_payment_cents")
  termMonths         Int     @map("term_months")
  noteRateBps        Int?    @map("note_rate_bps")
  /// Bridge fields — see the model comment.
  propertyAddress    String? @map("property_address")
  valueEstimateCents BigInt? @map("value_estimate_cents")

  origin ScenarioOrigin @default(BORROWER)

  isActive        Boolean @default(true) @map("is_active")
  supersededBySeq Int?    @map("superseded_by_seq")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([applicationId, seq])
  @@index([applicationId, isActive])
  @@map("loan_scenarios")
}

/// THE PIN. Exactly which relationship-held fact this credit request
/// borrowed, as of when, and under which authorization.
///
/// This is the mechanism of the whole design. An application holds no
/// borrower columns; it borrows facts from a party, and the pin is the legal
/// act — TRID's six pieces must be received IN CONNECTION WITH a request for
/// credit, not merely held on file. Inserting the sixth predicate IS the
/// receipt, and a trigger stamps it.
///
/// `authorizationId` is NOT NULL. A fact may be RETAINED on a party under a
/// retention obligation and still may not be BORROWED into a new credit
/// decision without a live authorization covering that request. The FCRA
/// retain-versus-borrow rule, as a column.
///
/// Both foreign keys CASCADE. A pin is a record about a person's data, and the
/// privacy page promises that data is removed "for good — there is no archive
/// and no undo". Restrict would make the first pinned fact the thing that
/// quietly breaks that promise. Controlling erasure properly is the retention
/// design's job, and it is deferred, exactly as for `facts`.
model ApplicationEvidenceLink {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  factId String @map("fact_id") @db.Uuid
  fact   Fact   @relation(fields: [factId], references: [id], onDelete: Cascade)

  authorizationId String        @map("authorization_id") @db.Uuid
  authorization   Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  /// Denormalized from the fact at pin time so the receipt trigger can count
  /// predicates without a join, and so the pin still says what it pinned if
  /// the fact is later superseded.
  predicate String

  borrowedAt DateTime  @default(now()) @map("borrowed_at")
  /// The fact's `observedAt` at the moment of pinning.
  asOf       DateTime  @map("as_of")
  /// Set when the application stops relying on it. Never deleted.
  releasedAt DateTime? @map("released_at")

  @@index([applicationId, predicate])
  @@index([factId])
  @@index([authorizationId])
  @@map("application_evidence_links")
}

enum ClockKind {
  TRID_LE_DELIVERY
  CD_BEFORE_CONSUMMATION
  RIGHT_OF_RESCISSION_3DAY
  ECOA_ADVERSE_ACTION_30D
  REG_B_INCOMPLETE_RESPONSE
  COUNTEROFFER_RESPONSE
}

/// A law with a date, as a durable timer.
///
/// `breachedAt` is terminal and retained — a breach is never tidied away. But a
/// clock whose satisfying channel does not exist must not be allowed to
/// breach on schedule either: the TRID Loan Estimate can only be satisfied by
/// a delivered disclosure, and there is no mailer in this repo. So a clock
/// opens TOLLED, with the reason recorded, until a delivery channel is
/// configured. Opening it live with no way to stop it would manufacture a
/// tamper-evident record of a breach we never had the means to avoid.
///
/// `dueAt` skips weekends only. Federal holidays need a calendar table this
/// slice does not add, so in a holiday week every deadline here is one day
/// optimistic — which is exactly the direction a regulatory clock must never
/// err. Until the calendar exists, clocks stay tolled and this is why.
model RegulatoryClock {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind            ClockKind
  statuteCitation String    @map("statute_citation")

  startedAt DateTime @map("started_at")
  dueAt     DateTime @map("due_at")

  tolledFrom    DateTime? @map("tolled_from")
  tollingReason String?   @map("tolling_reason")
  /// When the toll ended. `tolledFrom` and the reason are never cleared — a
  /// toll is a period with two ends, both recorded.
  tolledUntil   DateTime? @map("tolled_until")

  satisfiedAt DateTime? @map("satisfied_at")
  breachedAt  DateTime? @map("breached_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([applicationId, kind])
  @@index([dueAt])
  @@map("regulatory_clocks")
}

// ─── THE LOAN ───────────────────────────────────────────────────────────────

enum IntegrationDepth {
  NONE
  DEEP_LINK
  API
  SUBSERVICED
}

/// Who services a mortgage, and how deeply we are wired to them.
///
/// Integration depth lives here rather than on the loan because it is a
/// connection detail, not a lifecycle fact: becoming the subservicer for a
/// book of loans is a configuration change on one row, and as a loan state it
/// would be a migration plus a word a borrower would have to be shown.
model Servicer {
  id               String           @id @default(uuid()) @db.Uuid
  slug             String           @unique
  displayName      String           @map("display_name")
  integrationDepth IntegrationDepth @default(NONE) @map("integration_depth")

  createdAt DateTime @default(now()) @map("created_at")

  loans Loan[]

  @@map("servicers")
}

enum LoanState {
  PENDING_BOARDING
  BOARDING
  IMPORTED_UNCLAIMED
  ACTIVE
  MONITORING_ONLY
  IN_SERVICING_TRANSFER
  PAID_OFF
  REFINANCED_INTERNALLY
  TRANSFERRED_OUT
  CHARGED_OFF
  MATURED
}

enum LoanSource {
  ORIGINATION
  PARTNER_IMPORT
}

enum LoanRateType {
  FIXED
  ARM
}

/// The program a mortgage was written under. An axis in its own right, which
/// is why it is a column and why it is nullable: docs/states.md forbids
/// inferring it from the objective or the channel, and a feed that did not say
/// must not be answered with a guess.
enum LoanProgram {
  CONVENTIONAL
  HIGH_BALANCE
  JUMBO
  FHA
  VA
  USDA
  NON_QM
  AGRICULTURAL
}

/// A mortgage that exists in the world.
///
/// It outlives the application that made it, and it may have had no
/// application at all. Everything that moves month to month — the balance, the
/// escrow, whether a payment is late — is an observation with a date, never a
/// column here, and the four axes are nullable because NULL means the feed did
/// not tell us and nothing may infer one.
///
/// `status` is written ONLY by the loan transition service, and the same three
/// triggers that hold an application to its ledger hold a loan to its own,
/// plus three more: a loan is born in one of exactly two states, it cannot
/// claim to have been refinanced by us without naming the loan that did it,
/// and its ledger may never name a principal that dies with a person.
///
/// It declares NO relation to a loan file, deliberately. Every `loanFile
/// LoanFile` relation in this schema cascades — that is what makes "we remove
/// your data for good" true of a file's children — and a mortgage somebody is
/// paying is not a child of the file somebody typed into.
model Loan {
  id String @id @default(uuid()) @db.Uuid

  status          LoanState
  /// Increments on every transition. The ledger row for a move carries the
  /// same number, and `(loan_id, seq)` is unique — so two writers racing is an
  /// insert conflict rather than a lost update.
  statusSeq       Int       @default(0) @map("status_seq")
  statusEnteredAt DateTime  @default(now()) @map("status_entered_at")

  source LoanSource

  /// Nullable and load-bearing: a portfolio mortgage has no application behind
  /// it. SET NULL so a deleted application cannot erase the record of a
  /// mortgage somebody is paying.
  originatingApplicationId String?      @unique @map("originating_application_id") @db.Uuid
  originatingApplication   Application? @relation(fields: [originatingApplicationId], references: [id], onDelete: SetNull)

  servicerId String?   @map("servicer_id") @db.Uuid
  servicer   Servicer? @relation(fields: [servicerId], references: [id], onDelete: Restrict)

  /// The four axes. NULL means the feed did not say. A CHECK requires all four
  /// on a loan we originated, because we know our own.
  objective    ScenarioObjective?
  program      LoanProgram?
  lienPosition LienPosition?      @map("lien_position")
  occupancy    Occupancy?

  /// Terms at origination. Money is bigint cents and the rate is integer basis
  /// points, matching loan_scenarios.
  rateType               LoanRateType @map("rate_type")
  noteRateBps            Int          @map("note_rate_bps")
  termMonths             Int          @map("term_months")
  originalPrincipalCents BigInt       @map("original_principal_cents")
  originatedOn           DateTime?    @map("originated_on") @db.Date
  firstPaymentOn         DateTime?    @map("first_payment_on") @db.Date
  maturityOn             DateTime?    @map("maturity_on") @db.Date

  /// BRIDGE, in the same words loan_scenarios uses: there is no properties
  /// table yet. These move when it lands, and the readers move with them.
  propertyLine1      String? @map("property_line1")
  propertyLine2      String? @map("property_line2")
  propertyCity       String? @map("property_city")
  propertyState      String? @map("property_state") @db.VarChar(2)
  propertyPostalCode String? @map("property_postal_code")
  propertyApn        String? @map("property_apn")

  /// The attributable chain the monitoring loop exists to produce: which loan
  /// of ours retired this one.
  ///
  /// SET NULL, and the rule that a refinanced loan names its successor is a
  /// trigger on the MOVE rather than a CHECK on the row. A referential action
  /// is an UPDATE, so erasing the successor rewrites this column on a
  /// predecessor nothing named — and a CHECK would refuse that write from
  /// inside somebody else's DELETE, on a row too terminal to move out of the
  /// way first.
  refinancedByLoanId String? @map("refinanced_by_loan_id") @db.Uuid
  refinancedBy       Loan?   @relation("LoanRefinance", fields: [refinancedByLoanId], references: [id], onDelete: SetNull)
  refinanced         Loan[]  @relation("LoanRefinance")

  /// The monitoring seam. Same idiom and same index shape as connector_links',
  /// so a scheduler claims from one shape and not two. Unread for now.
  monitoringEnabled Boolean   @default(false) @map("monitoring_enabled")
  nextReviewDueAt   DateTime? @map("next_review_due_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parties     LoanParty[]
  transitions LoanTransition[]

  /// The index names here and on the two models below are pinned to what the
  /// migration wrote. Prisma names an unmapped index after its columns, and a
  /// name the model does not state is a name the next `prisma migrate dev`
  /// renames — folding a rename of somebody else's index into an unrelated
  /// migration.
  @@index([status, statusEnteredAt], map: "loans_status_entered")
  @@index([monitoringEnabled, nextReviewDueAt], map: "loans_review_due")
  @@index([originatingApplicationId], map: "loans_originating_app")
  @@map("loans")
}

/// Which parties are on a mortgage, and in what capacity.
///
/// Plural from the start, like ApplicationParty, and for a sharper reason: a
/// `loans.party_id` with a cascade would mean one co-borrower deleting their
/// account silently erases the other borrower's mortgage. The LINK is personal
/// data and cascades from the party; the loan itself goes only when the last
/// party leaves.
model LoanParty {
  id      String @id @default(uuid()) @db.Uuid
  loanId  String @map("loan_id") @db.Uuid
  loan    Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  partyId String @map("party_id") @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  role ApplicationPartyRole

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([loanId, partyId], map: "loan_parties_one_per_loan_party")
  @@index([partyId], map: "loan_parties_party")
  @@map("loan_parties")
}

/// Every move a mortgage made, in order, with its cause. Append-only.
///
/// `actorPrincipalId` is RESTRICT, exactly as an application transition's is,
/// and a trigger refuses any principal that belongs to a party: a loan outlives
/// its parties by design, so a row naming a borrower's own principal would be
/// an account that cannot be deleted at all. The person is recorded in
/// `loan_parties`; the actor is the service, the partner or the member of staff
/// that made the move.
model LoanTransition {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  /// Matches the loan's `statusSeq` after the move. Gapless from 1.
  seq Int

  fromState LoanState? @map("from_state")
  toState   LoanState  @map("to_state")
  event     String

  actorPrincipalId String    @map("actor_principal_id") @db.Uuid
  actor            Principal @relation("LoanTransitionActor", fields: [actorPrincipalId], references: [id])

  /// A code from a closed set, not free text — what an ops report groups by.
  reasonCode String? @map("reason_code")
  /// What produced it: an import batch, a claim grant, a servicing extract.
  causedBy   String? @map("caused_by")

  occurredAt DateTime @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@unique([loanId, seq], map: "loan_transitions_loan_seq")
  @@index([loanId, occurredAt], map: "loan_transitions_loan_occurred")
  @@map("loan_transitions")
}

// ─── DESKTOP UNDERWRITER ────────────────────────────────────────────────────
//
// What a submission to Desktop Underwriter needs and this repo has never
// stored. Additive, and mostly still unwritten: `du_declarations` and
// `du_residences` have a route and a screen behind them, and nothing else here
// does. The tables land first because the alternative to storage is a
// serializer inventing the answers, which is what the rest of this section
// still leaves it no choice but to do.
//
// Every `Du*` enum below is hand-typed, and `npm run du:verify` is what keeps
// it honest: it diffs each block against the members the DU Specification
// carries and fails on a member in either direction, in either file. A new
// enum needs its row in `DU_DATA_POINT_FOR_ENUM` in `scripts/build-du.mjs` in
// the same change, or there is nothing to diff it against — and the check says
// so rather than passing.

/// An enumerated type and not a boolean, because the wire carries the word.
///
/// MISMO's type is {No, Unknown, Yes}; DU refuses `Unknown`, so the DU subset
/// is these two and nothing here can hold a third answer. "We have not asked
/// yet" is the COLUMN being null, and only on the columns where DU's
/// conditionality permits absence.
enum DuYesNo {
  Yes
  No
}

/// How a property is used, for the DU data points whose set is three values.
///
/// Deliberately NOT the existing `Occupancy` enum, which already means
/// `PropertyUsageType` on the SUBJECT property. These are the same three words
/// meaning a different thing about a different property, and one enum shared
/// across DU data points is how a serializer produces a file that validates and
/// states something nobody said.
enum DuPropertyUsage {
  Investment
  PrimaryResidence
  SecondHome
}

enum DuPriorPropertyTitle {
  Sole
  JointWithSpouse
  JointWithOtherThanSpouse
}

/// DU supports four of MISMO's seven. ChapterFifteen, Other and Unknown are
/// schema-legal and DU-illegal, which schema validation will not catch.
enum DuBankruptcyChapter {
  ChapterSeven
  ChapterEleven
  ChapterTwelve
  ChapterThirteen
}

enum DuResidencyType {
  Current
  Prior
}

/// What the borrower's housing arrangement is.
///
/// `borrowers.current_housing` WAS asserted as "rent" by screen 2 and never
/// asked, and that value is what would have reached
/// `BorrowerResidencyBasisType` on a federally submitted application. A
/// fabricated answer is a worse failure than a missing one, so the column is
/// nullable now, screen 2 posts no basis at all, and this enum is the
/// vocabulary the borrower's real answer lands in when a screen finally asks.
enum DuResidencyBasis {
  Own
  Rent
  LivingRentFree
}

/// URLA Section 5, as of THIS credit request.
///
/// Keyed on the `application_parties` edge and not on the party, because a
/// declaration is not a standing truth about a person: "have you declared
/// bankruptcy in the past seven years" has a different answer on a different
/// date, and the answer a submission relied on must stay recoverable after the
/// borrower answers again. That is the same split a Fact draws against a row
/// scoped to one application.
///
/// TWELVE of the answers below are NOT NULL, and that is the whole point. The
/// wire format has no way to say "unanswered" — every element is nillable, so a
/// nil bankruptcy indicator is legal and meaningless, and an omitted one is an
/// incomplete file rather than an honest one. A nullable column would let a
/// half-answered declaration reach the serializer and be quietly completed with
/// `false`. A NOT NULL column makes the row unwritable until the borrower has
/// answered, which is where the refusal belongs.
///
/// NOTHING may derive these from connector output. Screen 4 reads them off a
/// credit pull today, so an unrun pull asserts "no bankruptcy" from an absence
/// of evidence, on a document the borrower signs. A clean credit report is
/// absence of evidence, not a "no". A trigger refuses an AI_AGENT, PARTNER or
/// SERVICE principal outright — the shape of `facts_ai_may_not_verify`, one
/// layer up — and refuses a borrower answering for somebody else.
model DuDeclaration {
  id                 String           @id @default(uuid()) @db.Uuid
  /// The edge, not the party. Cascades with it.
  applicationPartyId String           @unique @map("application_party_id") @db.Uuid
  applicationParty   ApplicationParty @relation(fields: [applicationPartyId], references: [id], onDelete: Cascade)

  /// Who said it, and when they said it. An assertion we sign for.
  ///
  /// A required Principal relation with no `onDelete` is ON DELETE RESTRICT,
  /// the same shape as `facts_asserted_by_principal_id_fkey`. Postgres fires
  /// the `principals` cascade before the `application_parties` cascade and
  /// checks RESTRICT immediately, so a plain `DELETE FROM parties` would raise
  /// on this edge even for a borrower's own self-attested row. The migration
  /// sweeps declarations off both `principals` and `parties` BEFORE DELETE,
  /// where the foreign key actually bites, so every call site that deletes a
  /// party still works and not only the account-deletion route. Both sweeps
  /// key on this column, which is why it is indexed.
  assertedByPrincipalId String    @map("asserted_by_principal_id") @db.Uuid
  assertedBy            Principal @relation("DeclarationAssertedBy", fields: [assertedByPrincipalId], references: [id])
  assertedAt            DateTime  @default(now()) @map("asserted_at")

  // ── 5a. About this property and your money for this loan ──────────────

  /// A. Required by DU. Per borrower, and NOT the same field as the subject
  /// property's occupancy: one borrower may intend to occupy and the other not,
  /// on the same property.
  intentToOccupy DuYesNo @map("intent_to_occupy")

  /// 5a.1.1. Required when A = Yes and forbidden otherwise, both directions
  /// enforced by a CHECK. Nullable in the column type because half the rows
  /// must not carry it, not because an occupying borrower may leave it
  /// unanswered. They may not.
  homeownerPastThreeYears DuYesNo? @map("homeowner_past_three_years")

  /// 5a.1.2. Conditional on A = Yes AND 5a.1.1 = Yes.
  priorPropertyUsage DuPropertyUsage? @map("prior_property_usage")

  /// 5a.1.3. Optional everywhere, and emitted by most sample files whenever
  /// 5a.1.1 is Yes. It carries NO conditionality statement of its own, so it
  /// gets no CHECK: a constraint DU does not state is a constraint that refuses
  /// rows DU accepts.
  priorPropertyTitle DuPriorPropertyTitle? @map("prior_property_title")

  /// The other 5a.1.2 data point: optional for DU and conditionally required on
  /// an FHA file whose borrower intends to occupy and has owned before. One of
  /// two fields in this set whose conditionality moves with the product type,
  /// which is why it is nullable and why the preflight, not a CHECK, is what
  /// requires it.
  fhaSecondaryResidence Boolean? @map("fha_secondary_residence")

  /// B. Conditional on the LOAN's purpose being Purchase — a borrower-scoped
  /// field whose condition is a loan-level one, so no CHECK on this table can
  /// see it.
  specialBorrowerSellerRelationship Boolean? @map("special_borrower_seller_relationship")

  /// C. Required by DU.
  undisclosedBorrowedFunds Boolean @map("undisclosed_borrowed_funds")

  /// 5a.3.1. Conditional on C, in both directions. Cents; the set's only money.
  undisclosedBorrowedFundsCents BigInt? @map("undisclosed_borrowed_funds_cents")

  /// D.1 and D.2. Two required booleans behind one lettered question — the
  /// place a naive A-through-M enumeration loses a field.
  undisclosedMortgageApplication Boolean @map("undisclosed_mortgage_application")
  undisclosedCreditApplication   Boolean @map("undisclosed_credit_application")

  /// E. Required by DU, and distinct from the collateral field that records a
  /// clean energy lien already on the property. Proposed is a declaration;
  /// existing is not.
  propertyProposedCleanEnergyLien Boolean @map("property_proposed_clean_energy_lien")

  // ── 5b. About your finances ───────────────────────────────────────────

  /// F through M, all required by DU except I.
  undisclosedComakerOfNote Boolean @map("undisclosed_comaker_of_note")
  outstandingJudgments     Boolean @map("outstanding_judgments")
  presentlyDelinquent      Boolean @map("presently_delinquent")

  /// I. Optional for DU, required on an FHA or VA file, and emitted by every
  /// sample file including the conventional ones. Nullable so it can be
  /// genuinely unasked, and the preflight requires it on a government file.
  partyToLawsuit Boolean? @map("party_to_lawsuit")

  /// J, K and L. One question in the legacy dataset and three independent
  /// required booleans now; a single "adverse property event" flag cannot
  /// produce them.
  priorPropertyDeedInLieuConveyed   Boolean @map("prior_property_deed_in_lieu_conveyed")
  priorPropertyShortSaleCompleted   Boolean @map("prior_property_short_sale_completed")
  priorPropertyForeclosureCompleted Boolean @map("prior_property_foreclosure_completed")

  /// M. Required by DU, and the gate on the chapters below.
  bankruptcy Boolean @map("bankruptcy")

  /// The borrower's own words. DU consumes no explanation element at all, yet
  /// two of these questions carry the instruction that a yes must be explained.
  /// This text is for the 1003, the underwriter and the file's own record, and
  /// the serializer must never go looking for somewhere to put it. It is what
  /// the review screen collects and discards today.
  explanations Json? @map("explanations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chapters DuBankruptcyFiling[]

  @@index([assertedByPrincipalId])
  @@map("du_declarations")
}

/// Which chapters, when M is true.
///
/// A SET, not a value and not a list of filings: URLA asks for "the type(s)",
/// the container repeats up to four times, and there are exactly four legal
/// chapters. DU maps one element of the bankruptcy detail and no other — no
/// date, no case number, no amount — so there is nothing else to carry.
///
/// No sample file in the corpus exercises this branch; all of them answer the
/// bankruptcy indicator false. It is built from the specification with no
/// reference instance to diff against, which makes it the likeliest place for a
/// first rejection. The unique pair below is also what caps it at four.
model DuBankruptcyFiling {
  id            String              @id @default(uuid()) @db.Uuid
  declarationId String              @map("declaration_id") @db.Uuid
  declaration   DuDeclaration       @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  chapter       DuBankruptcyChapter

  @@unique([declarationId, chapter])
  @@map("du_bankruptcy_filings")
}

/// Where the borrower lives, and where they lived before, as of this request.
///
/// The container repeats up to twice — one current, one former — the residency
/// type is required by DU, and a prior residence is conditionally required when
/// the current one is under twenty-four months. So this is a
/// minimum-cardinality gap of the same kind as the missing declaration.
///
/// It is worse than absent. `borrowers.current_housing` was asserted as "rent"
/// by screen 2 and never asked, and `borrowers.monthly_rent` and the
/// `current_housing` / `monthly_rent` Fact predicates are two more stores of
/// the same two facts. Three stores for one number is drift waiting to happen,
/// so this table is the single source of truth for the housing basis and the
/// rent, and those two columns are the derived copies that follow the Current
/// row here. What is still not done is ASKING: no screen posts a basis, so a
/// new file carries none at all.
///
/// The CURRENT residence's address is NOT stored here: it is the pinned
/// `current_address` fact on the party, read at emission, so there is one
/// storage and two renderings. The PRIOR residence's address IS stored here,
/// because there is no `prior_address` predicate in this codebase to read it
/// from and inventing a durable Party fact for "where you used to live" would
/// be a new predicate, a new writer and a new pinning rule in the service of
/// one element on one application. A CHECK binds the address columns to
/// `residency_type` in both directions.
///
/// A borrower with any residence row has a Current one. A DEFERRABLE constraint
/// trigger says so at COMMIT, because `recordDeclaration` replaces the whole set
/// and there is an instant mid-transaction when the borrower has none — and
/// without it a set carrying only a Prior residence would leave
/// `borrowers.current_housing` stating a basis whose source row no longer
/// exists, which is the drift this table was added to end.
model DuResidence {
  id                 String           @id @default(uuid()) @db.Uuid
  applicationPartyId String           @map("application_party_id") @db.Uuid
  applicationParty   ApplicationParty @relation(fields: [applicationPartyId], references: [id], onDelete: Cascade)

  residencyType DuResidencyType  @map("residency_type")
  basis         DuResidencyBasis

  /// How long they have lived there. Numeric 3 on the wire, so 1000 months is
  /// not a longer tenancy, it is a rejected file. A CHECK carries both bounds.
  durationMonths Int @map("duration_months")

  /// The rent, in cents. It does not live on the residence element on the wire
  /// but on a landlord container the emitter has to create when this column is
  /// non-null and omit when it is not — named here because a column whose
  /// container the emitter has to invent is a container the emitter will
  /// forget.
  ///
  /// Its CHECK is ONE-directional: an amount requires a Rent basis, and a Rent
  /// basis does not require an amount. DU's condition is "basis is Rent AND the
  /// amount exists", and a prior residence rented eight years ago whose rent
  /// nobody remembers is a legal file.
  monthlyRentCents BigInt? @map("monthly_rent_cents")

  /// PRIOR residences only; null on a Current row, which reads its address from
  /// the pinned fact. Each column has a wire length, and a CHECK carries it
  /// rather than trusting the writer.
  addressLineText String? @map("address_line_text")
  addressUnit     String? @map("address_unit")
  cityName        String? @map("city_name")
  stateCode       String? @map("state_code")
  postalCode      String? @map("postal_code")
  countryCode     String? @map("country_code")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([applicationPartyId, residencyType])
  @@map("du_residences")
}

// ─── ASSETS, LIABILITIES, EXPENSES AND OWNED PROPERTY ───────────────────────
//
// URLA sections 2a, 2b, 2c, 2d, 3a and 4d. They hang off the APPLICATION and
// not off a borrower: `DEAL/ASSETS/ASSET` is a sibling of `PARTIES`, and who
// owns an asset is an arc between the two. Nothing here carries an owner
// column, and the join that carries the arc is not in this change — an asset
// written today has no owner and nothing yet requires one.

/// Which URLA section a stored asset belongs to.
///
/// Ours, with no DU data point behind it. One XML container serves four
/// sections whose fields are disjoint, and this is what says which set of them
/// a row is allowed to fill. It is also the discriminator the emitter keys
/// conditionality on, so a row whose kind disagrees with its `assetType` would
/// be emitted under the wrong rules — which is why the per-kind CHECKs in the
/// migration name the AssetType values each section carries rather than only
/// which columns must be null.
enum DuAssetKind {
  DEPOSIT_ACCOUNT
  OTHER_ASSET
  GIFT_OR_GRANT
  OWNED_PROPERTY
}

/// `AssetType`, the union across 2a.1, 2b.1 and 4d.1. Which members a row may
/// take is decided by its `kind`, in the database.
enum DuAssetType {
  // 2a.1 — the accounts.
  Bond
  BridgeLoanNotDeposited
  CertificateOfDepositTimeDeposit
  CheckingAccount
  IndividualDevelopmentAccount
  LifeInsurance
  MoneyMarketFund
  MutualFund
  RetirementFund
  SavingsAccount
  Stock
  StockOptions
  TrustAccount
  // 2b.1 — the other assets and credits.
  CashOnHand
  Other
  PendingNetSaleProceedsFromRealEstateAssets
  ProceedsFromSaleOfNonRealEstateAsset
  ProceedsFromSecuredLoan
  ProceedsFromUnsecuredLoan
  // 4d.1 — gifts and grants.
  GiftOfCash
  GiftOfPropertyEquity
  Grant
}

/// `AssetTypeOtherDescription`, which is an enumeration and not free text.
///
/// The Map types it `String (DU Enumerated)` and the DU Enumerations tab gives
/// it exactly these two members. Held as text it would take a borrower's "Coin
/// collection" through every check this repo has — the XSD types the element as
/// a plain string — and into a DU rejection days later.
enum DuAssetTypeOtherDescription {
  OtherLiquidAsset
  OtherNonLiquidAsset
}

/// Who the gift or grant came from. 4d.2 on the wire.
///
/// `PropertySeller` is a thirteenth member of this data point on
/// ORIGINATION_FUND and is deliberately absent: a gift or grant on an ASSET
/// cannot come from the seller.
enum DuFundsSourceType {
  CommunityNonProfit
  Employer
  FederalAgency
  Lender
  LocalAgency
  Other
  Parent
  Relative
  ReligiousNonProfit
  StateAgency
  UnmarriedPartner
  UnrelatedFriend
}

/// `LiabilityType`. 2c.1 is what the borrower declares and 3a.11 the mortgages
/// against owned property; one column holds both, so this is their union.
enum DuLiabilityType {
  CollectionsJudgmentsAndLiens
  Installment
  LeasePayment
  Open30DayChargeAccount
  Other
  Revolving
  Taxes
  TaxLien
  HELOC
  MortgageLoan
}

/// `MortgageType` on LIABILITY_DETAIL (3a.14). One legal value, and it is not
/// the loan-level MortgageType on TERMS_OF_LOAN, which is a different data
/// point with a wider set.
enum DuLiabilityMortgageType {
  FHA
}

enum DuExpenseType {
  Alimony
  ChildSupport
  JobRelatedExpenses
  Other
  SeparateMaintenanceExpense
}

/// What the borrower intends to do with a property they already own.
enum DuOwnedPropertyDisposition {
  PendingSale
  Retain
  Sold
}

/// 3a.5 `PropertyUsageType`. Four values, and deliberately not `DuPropertyUsage`
/// — this is the one usage data point that admits `Other`, and merging the two
/// would let `Other` reach a destination whose set is three words.
enum DuIntendedPropertyUsage {
  Investment
  Other
  PrimaryResidence
  SecondHome
}

/// `PropertyUsageTypeOtherDescription`, the six things a retained property can
/// be when it is none of the three occupancy words. This is what lets a farm, a
/// timeshare or an undeveloped lot be an REO without asserting a usage that is
/// not true.
enum DuPropertyUsageOtherDescription {
  Chattel
  Commercial
  Farm
  Land
  Multifamily
  Timeshare
}

/// One asset: a deposit account, another asset, a gift or grant, or a property
/// the borrower already owns.
///
/// One table for four URLA sections because they are one XML container. What
/// keeps that from being a bag of nullable columns is `kind`: the migration
/// gives each kind the AssetType values its section carries and the columns it
/// may fill, so a row cannot claim to be a 4d gift and carry a checking
/// account's fields.
model DuAsset {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind DuAssetKind

  /// Null on an OWNED_PROPERTY row, with every other ASSET_DETAIL column, by
  /// CHECK. An REO asset carries no ASSET_DETAIL at all — the XSD permits the
  /// combination, so the database is the only place it is refused.
  ///
  /// Nullable only for that one kind: the per-kind shape CHECKs require it on
  /// the other three, and require it from that kind's own section list. It is
  /// what tells the emitter which conditionality a row is under, so a row
  /// without one is a row nothing downstream can read.
  assetType                       DuAssetType?                 @map("asset_type")
  assetTypeOtherDescription       DuAssetTypeOtherDescription? @map("asset_type_other_description")
  cashOrMarketValueCents          BigInt?                      @map("cash_or_market_value_cents")
  /// DEPOSIT_ACCOUNT only. `ASSET_HOLDER/NAME/FullName`, String 150.
  holderName                      String?                      @map("holder_name")
  /// `AssetAccountIdentifier`, String 30.
  accountIdentifier               String?                      @map("account_identifier")
  /// GIFT_OR_GRANT only.
  fundsSourceType                 DuFundsSourceType?           @map("funds_source_type")
  /// 4d.3, String 80, required exactly when the source is `Other`. Genuinely a
  /// bare string, unlike its neighbor above.
  fundsSourceTypeOtherDescription String?                      @map("funds_source_type_other_description")
  /// 4d.2, and only for a gift of cash or a grant: a gift of property equity is
  /// a credit in the transaction and was never in an account to be included in.
  includedInAssetAccount          Boolean?                     @map("included_in_asset_account")

  /// Which vendor report this figure came from, so a number on the wire can be
  /// traced to the pull that produced it. Null for a row a person typed, and
  /// saying so is the honest answer.
  sourceSnapshotId String?            @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   ConnectorSnapshot? @relation("DuAssetSource", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  /// What a second pull recognizes this row by, so it is updated rather than
  /// duplicated. The same five columns as `IncomeSource`, and for the same
  /// reason: without them a re-pull can only insert a twin or delete and
  /// recreate, and both renumber every ASSET_n on the wire.
  ///
  /// Computed by `assetIdentityKeys` in `packages/du`, which states the rule and
  /// what each part of it costs. Three things a reader needs here: a
  /// connector-written key opens with the SUBJECT PARTY, because this index
  /// spans the application while the key is computed from one vendor's payload
  /// about one person; there is no ordinal in it, because a position is the
  /// vendor's row order wearing another name and a re-pull that reorders would
  /// swap two rows' balances and owners silently; and a row a person typed
  /// takes `manual:<uuid>`, which matches nothing on purpose.
  ///
  /// What that does NOT buy, because the column looks the same either way: an
  /// unmasked account that closed and one that opened after it at the same bank
  /// in the same subtype compute one key, so the second takes the first's row
  /// and its owner arcs. Only a vendor item id tells those two apart.
  identityKey         String             @map("identity_key")
  firstSeenSnapshotId String?            @map("first_seen_snapshot_id") @db.Uuid
  firstSeenSnapshot   ConnectorSnapshot? @relation("DuAssetFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: SetNull)
  lastSeenSnapshotId  String?            @map("last_seen_snapshot_id") @db.Uuid
  lastSeenSnapshot    ConnectorSnapshot? @relation("DuAssetLastSeen", fields: [lastSeenSnapshotId], references: [id], onDelete: SetNull)
  /// Superseded rather than deleted — you cannot diff against a row you
  /// deleted, and only live rows are emitted.
  retiredAt           DateTime?          @map("retired_at")
  retiredBySnapshotId String?            @map("retired_by_snapshot_id") @db.Uuid
  retiredBySnapshot   ConnectorSnapshot? @relation("DuAssetRetiredBy", fields: [retiredBySnapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedProperty DuOwnedProperty?
  /// Whose asset it is. At least one, at COMMIT, by a deferred constraint
  /// trigger: an ASSET with no owner arc is a row that cannot be emitted.
  owners        DuAssetParty[]
  /// The other end of the composite foreign key on `du_owned_properties`, which
  /// Prisma requires a field for. A list only because Prisma reserves the 0:1
  /// spelling for a relation whose own columns are unique: `asset_id` is
  /// unique, so this holds `ownedProperty` and nothing else.
  reoProperty   DuOwnedProperty[] @relation("DuOwnedPropertyAttachesToAnReoAsset") @ignore

  /// Spans retired rows on purpose, word for word the reasoning
  /// `income_sources_file_party_identity_key` carries: an asset that goes away
  /// and comes back is one asset, so a later pull revives the row rather than
  /// inserting a twin. A partial index `WHERE retired_at IS NULL` would let a
  /// retired row and a live row share a key, and the twin it admits renumbers
  /// every ASSET_n after it.
  @@unique([applicationId, identityKey], map: "du_assets_application_identity_key")
  /// Not a rule about assets — it is the target the composite foreign key on
  /// `du_owned_properties` needs, and Postgres requires a unique index on the
  /// referenced columns. `id` is already the primary key, so this admits
  /// nothing new; what it does is let an owned property name its parent's kind
  /// as well as its id, which is how "only an REO asset has one" is held.
  @@unique([id, kind], map: "du_assets_id_kind")
  @@index([applicationId])
  @@map("du_assets")
}

/// URLA 3a. A 0:1 child OF an asset, never a sibling.
///
/// This is the one structural rule MISMO itself enforces: moving
/// `<OWNED_PROPERTY>` to a DEAL-level position beside `<COLLATERALS>` fails
/// schema validation, and there is no other legal location. `asset_id` being
/// unique and not null is the 0:1; the cascade is the nesting; and a composite
/// foreign key in the migration makes OWNED_PROPERTY the only kind of asset one
/// of these may hang off.
model DuOwnedProperty {
  id      String  @id @default(uuid()) @db.Uuid
  assetId String  @unique @map("asset_id") @db.Uuid
  asset   DuAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Denormalized from the asset and written ONLY by a trigger. A partial
  /// unique index cannot see through the asset to the application, and "at most
  /// one subject REO per application" has to be an index. Nothing sets it by
  /// hand; a value passed to `create()` is overwritten.
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// A generated column holding the one value it can hold, so that
  /// `(asset_id, asset_kind)` can only match an asset whose kind is
  /// OWNED_PROPERTY. Prisma has no representation for a generated column, so it
  /// is raw SQL in the migration and `@ignore`d here — declared all the same,
  /// because an undeclared column is drift, and the DROP COLUMN the next
  /// `prisma migrate dev` would propose takes the foreign key with it.
  ///
  /// Optional, and the `@default` is how Prisma reads the generation
  /// expression. Both halves are what the introspected shape actually is: a
  /// STORED generated column is nullable in the catalog, and declaring this
  /// required makes `prisma migrate diff` propose `SET NOT NULL` — drift again,
  /// pointed the other way. Nothing writes it; Postgres refuses to let anything
  /// try.
  assetKind DuAssetKind? @default(OWNED_PROPERTY) @map("asset_kind") @ignore

  /// The composite foreign key, spelled the only way Prisma can spell one. It
  /// names the same parent row as `asset` above and buys no second traversal —
  /// what it buys is that `(asset_id, asset_kind)` is checked against
  /// `(id, kind)`, so an owned property cannot hang off a deposit account.
  /// Ignored, because nothing should read the parent twice.
  reoAsset DuAsset? @relation("DuOwnedPropertyAttachesToAnReoAsset", fields: [assetId, assetKind], references: [id, kind], onDelete: Cascade, onUpdate: NoAction, map: "du_owned_properties_attach_to_an_reo_asset") @ignore

  dispositionStatus DuOwnedPropertyDisposition @map("disposition_status")
  /// True on the one REO that IS the subject property of this application.
  /// There is no arc joining the REO schedule to COLLATERALS — this boolean is
  /// the link, and a partial unique index holds at most one per application.
  isSubject         Boolean                    @default(false) @map("is_subject")

  /// Null on a subject REO means "render the subject property's address here".
  ///
  /// The two destinations are not the same width — AddressLineText is String 50
  /// under the subject property and String 35 here — so a legal 41-character
  /// street line is valid at one and invalid at the other, and byte-identity
  /// between the two renderings is unsatisfiable rather than merely unenforced.
  /// A value stored here says this REO's address is recorded as different. A
  /// non-subject REO must carry its own, because nothing else knows it.
  addressLineText String? @map("address_line_text")
  addressUnit     String? @map("address_unit")
  cityName        String? @map("city_name")
  stateCode       String? @map("state_code")
  /// MISMO 3.4 does not separate zip from zip+4: five digits or nine, no dash.
  postalCode      String? @map("postal_code")
  countryCode     String? @map("country_code")

  currentUsage                  DuPropertyUsage?                 @map("current_usage")
  /// 3a.5. Conditional on the disposition being `Retain`.
  intendedUsage                 DuIntendedPropertyUsage?         @map("intended_usage")
  /// Present exactly when the intended usage is `Other`, by CHECK.
  intendedUsageOtherDescription DuPropertyUsageOtherDescription? @map("intended_usage_other_description")
  estimatedValueCents           BigInt?                          @map("estimated_value_cents")

  /// DERIVED, and never written by a caller.
  ///
  /// 3a.12 is "the total amount of all remaining mortgages and liens against
  /// the owned real property" — the total across every live liability securing
  /// this row, not the balance of any one of them. Two triggers keep it: one
  /// here and one on `du_liabilities`, so a second lien added by a credit
  /// re-pull moves the figure with nobody recomputing it. A value passed to
  /// `create()` or `update()` is overwritten rather than refused. Null when no
  /// live liability points at the row, which is a property owned free and clear.
  lienUpbCents            BigInt? @map("lien_upb_cents")
  /// Conditional on the securing LIABILITY saying its payment does not include
  /// taxes and insurance — a condition on a different container, reachable only
  /// along the arc, so no CHECK on this table can see it.
  maintenanceExpenseCents BigInt? @map("maintenance_expense_cents")
  /// 3a.7, optional with no conditionality of its own. Zero is a legitimate
  /// answer: a retained second home is not rented out.
  rentalIncomeGrossCents  BigInt? @map("rental_income_gross_cents")
  /// 3a.8, conditional on the disposition being `Retain`. Legitimately
  /// negative — a rental that loses money emits a negative net amount — so the
  /// bound on it is signed while every other amount here is not.
  rentalIncomeNetCents    BigInt? @map("rental_income_net_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  securedBy DuLiability[]

  @@map("du_owned_properties")
}

/// URLA 2c and 3a.9-3a.15, which are one XML container.
model DuLiability {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  liabilityType                 DuLiabilityType          @map("liability_type")
  /// 2c.1, String 80, required exactly when the type is `Other`.
  liabilityTypeOtherDescription String?                  @map("liability_type_other_description")
  /// `LIABILITY_HOLDER/NAME/FullName`, String 150.
  holderName                    String                   @map("holder_name")
  accountIdentifier             String?                  @map("account_identifier")
  /// 3a.14. It belongs to the REO mortgage variant, like the two indicators
  /// below, and a CHECK binds it there.
  mortgageType                  DuLiabilityMortgageType? @map("mortgage_type")

  unpaidBalanceCents  BigInt  @map("unpaid_balance_cents")
  monthlyPaymentCents BigInt  @map("monthly_payment_cents")
  /// `LiabilityRemainingTermMonthsCount`, Numeric 3 on the wire. A thousand
  /// months is not a longer term, it is a rejected file.
  remainingTermMonths Int?    @map("remaining_term_months")
  payoffStatus        Boolean @map("payoff_status")
  /// Excluded from the ratios, with a reason a human wrote.
  exclusionIndicator  Boolean @default(false) @map("exclusion_indicator")

  /// HELOC only, by CHECK.
  helocMaximumBalanceCents      BigInt?  @map("heloc_maximum_balance_cents")
  /// MortgageLoan and HELOC only, and it is what makes the owned property's
  /// maintenance expense conditionally required.
  paymentIncludesTaxesInsurance Boolean? @map("payment_includes_taxes_insurance")

  /// The property this lien is against, and the arc that is a foreign key
  /// rather than a join table.
  ///
  /// `ASSET_IsAssociatedWith_LIABILITY` is many-to-many in the abstract. Across
  /// the eighteen shipped samples there are 23 of these arcs and not one
  /// liability is the target of more than one asset; what the corpus does show
  /// is one property with two liens, a first mortgage and a HELOC, which is
  /// exactly what a nullable foreign key on this side expresses. A trigger
  /// keeps it inside one application: an arc across two of them emits an
  /// `xlink:from` naming a label the document does not contain, and the XSD
  /// accepts that silently.
  securedByOwnedPropertyId String?          @map("secured_by_owned_property_id") @db.Uuid
  securedByOwnedProperty   DuOwnedProperty? @relation(fields: [securedByOwnedPropertyId], references: [id], onDelete: SetNull)

  sourceSnapshotId String?            @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   ConnectorSnapshot? @relation("DuLiabilitySource", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  /// Re-pull identity, the same five columns as an asset's and for the same
  /// reason. A credit re-pull that recognizes a tradeline updates this row
  /// rather than inserting a twin.
  identityKey         String             @map("identity_key")
  firstSeenSnapshotId String?            @map("first_seen_snapshot_id") @db.Uuid
  firstSeenSnapshot   ConnectorSnapshot? @relation("DuLiabilityFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: SetNull)
  lastSeenSnapshotId  String?            @map("last_seen_snapshot_id") @db.Uuid
  lastSeenSnapshot    ConnectorSnapshot? @relation("DuLiabilityLastSeen", fields: [lastSeenSnapshotId], references: [id], onDelete: SetNull)
  retiredAt           DateTime?          @map("retired_at")
  retiredBySnapshotId String?            @map("retired_by_snapshot_id") @db.Uuid
  retiredBySnapshot   ConnectorSnapshot? @relation("DuLiabilityRetiredBy", fields: [retiredBySnapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Who owes it. At least one, at COMMIT, for the reason an asset needs an
  /// owner: the arc is how DU learns whose liability this is.
  obligors DuLiabilityParty[]

  /// Full, spanning retired rows, for the reason spelled out on `DuAsset`.
  @@unique([applicationId, identityKey], map: "du_liabilities_application_identity_key")
  @@index([applicationId])
  @@index([securedByOwnedPropertyId])
  @@map("du_liabilities")
}

/// Alimony, child support, job-related expenses. `EXPENSE` is the one container
/// in this set with no `_DETAIL` child — the fields hang directly off it.
model DuExpense {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  expenseType             DuExpenseType @map("expense_type")
  /// 2d.1. Present exactly when the type is `Other`, by CHECK, in both
  /// directions — an expense filed as `Other` and left unexplained says
  /// nothing.
  expenseOtherDescription String?       @map("expense_other_description")
  monthlyPaymentCents     BigInt        @map("monthly_payment_cents")
  /// `ExpenseRemainingTermMonthsCount`, Numeric 3, same as a liability's.
  remainingTermMonths     Int?          @map("remaining_term_months")
  /// OURS, not DU's. The EXPENSE container carries four data points and this is
  /// none of them, so the serializer must never look for somewhere to put it.
  /// Marked the way `du_declarations.explanations` is marked, because in a set
  /// of tables whose warrant is that every column is a named row in a named
  /// extract, an unmarked column that is not one reads as a citation nobody
  /// checked.
  alimonyOwedToName       String?       @map("alimony_owed_to_name")

  createdAt DateTime @default(now()) @map("created_at")

  /// Who pays it. At least one, at COMMIT. An expense has no `retiredAt` — a
  /// person types one and no connector supersedes it — so the check that reads
  /// this list is told so rather than assuming the column exists.
  payers DuExpenseParty[]

  @@index([applicationId])
  @@map("du_expenses")
}

// ─── THE ARCS, AS TABLES ────────────────────────────────────────────────────
//
// `ASSET_IsAssociatedWith_ROLE` is the most common arc in the corpus, 126
// instances, and its two siblings work the same way. Each is a join table
// rather than a column because two rows for one asset IS joint ownership:
// MISMO has no "joint" flag and no place on a RELATIONSHIP to record a share,
// so a 60/40 split has no wire representation and a second owner is a second
// arc.
//
// All four point at `application_parties`, not at `parties`. The arc's endpoint
// is the ROLE element, which is emitted from the EDGE — so a party merge, or a
// borrower dropped on resubmission, would otherwise leave an arc naming a label
// the document does not contain, which the XSD accepts in silence. Pointing at
// the edge makes removing the borrower remove the arc.
//
// A deferred constraint trigger refuses to let a transaction commit with a live
// asset, liability or expense that has no arc at all, and it fires on these
// tables' deletes as well as on the parent's writes. `writeAsset` in
// `packages/du` is the shape that can satisfy it: the row and its owners in one
// transaction.

/// Who owns an asset. `role` carries a distinction we need and DU does not —
/// which borrower supplied the statement — without polluting the arc, which on
/// the wire is an empty element with a from, a to and an arcrole.
model DuAssetParty {
  id                 String           @id @default(uuid()) @db.Uuid
  assetId            String           @map("asset_id") @db.Uuid
  asset              DuAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  applicationPartyId String           @map("application_party_id") @db.Uuid
  applicationParty   ApplicationParty @relation(fields: [applicationPartyId], references: [id], onDelete: Cascade)

  role String @default("OWNER")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assetId, applicationPartyId])
  @@index([applicationPartyId])
  @@map("du_asset_parties")
}

/// `LIABILITY_IsAssociatedWith_ROLE`, 120 instances.
model DuLiabilityParty {
  id                 String           @id @default(uuid()) @db.Uuid
  liabilityId        String           @map("liability_id") @db.Uuid
  liability          DuLiability      @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  applicationPartyId String           @map("application_party_id") @db.Uuid
  applicationParty   ApplicationParty @relation(fields: [applicationPartyId], references: [id], onDelete: Cascade)

  role String @default("OBLIGOR")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([liabilityId, applicationPartyId])
  @@index([applicationPartyId])
  @@map("du_liability_parties")
}

/// `EXPENSE_IsAssociatedWith_ROLE`. Two instances in the corpus, both n:1 — and
/// a join table anyway, because the wording of the arc role is identical to the
/// asset's and alimony can be joint. A foreign key here would be a bet against
/// a shape nothing forbids, for no saving.
model DuExpenseParty {
  id                 String           @id @default(uuid()) @db.Uuid
  expenseId          String           @map("expense_id") @db.Uuid
  expense            DuExpense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  applicationPartyId String           @map("application_party_id") @db.Uuid
  applicationParty   ApplicationParty @relation(fields: [applicationPartyId], references: [id], onDelete: Cascade)

  role String @default("PAYER")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([expenseId, applicationPartyId])
  @@index([applicationPartyId])
  @@map("du_expense_parties")
}

/// `ROLE_SharesJointCreditReportWith_ROLE`. Directed, and the direction is
/// load-bearing: the group's primary goes under `to` and the additional
/// borrower under `from`, and reversing it makes DU read the wrong borrower as
/// primary.
///
/// It is a GROUPING, not a star and not a flag. DI-C02 emits BORROWER_3 →
/// BORROWER_2 while BORROWER_1 stands alone, so the primary of a joint pair is
/// not the application's primary borrower and cannot be derived from
/// PRIMARY_BORROWER versus CO_BORROWER. A boolean column cannot express it, and
/// a symmetric join row emits it backwards half the time.
model DuJointCreditReportLink {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The additional borrower.
  fromApplicationPartyId String           @map("from_application_party_id") @db.Uuid
  fromApplicationParty   ApplicationParty @relation("JointCreditFrom", fields: [fromApplicationPartyId], references: [id], onDelete: Cascade)
  /// The group's primary.
  toApplicationPartyId   String           @map("to_application_party_id") @db.Uuid
  toApplicationParty     ApplicationParty @relation("JointCreditTo", fields: [toApplicationPartyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  /// One group per additional borrower: a borrower whose report is shared with
  /// two different primaries is two contradictory groups. A trigger checks the
  /// rest — that both endpoints are borrowing edges on THIS application, and
  /// that a group primary is not also somebody else's additional borrower.
  @@unique([applicationId, fromApplicationPartyId], map: "du_joint_credit_links_one_group_per_additional_borrower")
  @@index([applicationId, toApplicationPartyId], map: "du_joint_credit_links_by_group_primary")
  @@map("du_joint_credit_report_links")
}
