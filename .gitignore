# Terraform state is local and applied by hand, and none of it is ever
# committed: the state, its backups (terraform.tfstate.backup, and the
# timestamped ones `terraform state` writes) and the lock file.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*

