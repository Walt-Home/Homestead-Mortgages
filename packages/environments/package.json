{
  "name": "@hm/environments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "env:refi": "tsx src/cli.ts",
    "env:compare": "tsx src/compare-cli.ts",
    "env:audit": "tsx src/audit-cli.ts",
    "env:archive": "tsx src/archive-cli.ts",
    "env:transfer-package": "tsx src/boarding/package-cli.ts",
    "env:playground": "node scripts/build-playground.mjs",
    "env:demo": "node scripts/build-demo.mjs",
    "env:gym": "node scripts/build-playground.mjs && python3 -m http.server 8765 --directory playground/dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@anthropic-ai/vertex-sdk": "0.20.2",
    "@hm/kernel": "*",
    "@hm/refi-review": "*",
    "@hm/shared": "*",
    "@hm/underwriting": "*"
  },
  "devDependencies": {
    "@hm/partner-book": "*",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
