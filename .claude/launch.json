{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@hm/web"],
      "port": 5173
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEMO_PERSONAS=true",
        "GOOGLE_CLIENT_ID=",
        "npm",
        "run",
        "dev",
        "--workspace=@hm/api"
      ],
      "port": 8080
    },
    {
      "name": "servicing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@hm/servicing"],
      "port": 8090
    },
    {
      "name": "servicing-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SERVICING_DATABASE_URL=postgresql://homestead_mortgages:homestead_mortgages@localhost:5433/hm_servicing_console",
        "SERVICING_ENVIRONMENT=nonprod",
        "npm",
        "run",
        "start",
        "--workspace=@hm/servicing"
      ],
      "port": 8090
    },
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@hm/console"],
      "port": 5174,
      "url": "http://localhost:5174"
    }
  ]
}
