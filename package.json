{
  "name": "homestead-mortgages",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test --filter=!@hm/servicing",
    "check": "tsc -b && npm run requirements:verify && npm run brand:verify && npm run du:verify && npm run apor:verify && npm run typecheck -w @hm/servicing",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "requirements:build": "node scripts/build-requirements.mjs",
    "requirements:verify": "node scripts/build-requirements.mjs --verify",
    "brand:build": "npm run build --workspace=@hm/brand",
    "brand:verify": "npm run verify --workspace=@hm/brand",
    "du:build": "node scripts/build-du.mjs",
    "du:verify": "node scripts/build-du.mjs --verify",
    "db:generate": "npm run generate --workspace=@hm/db",
    "db:migrate": "npm run migrate --workspace=@hm/db",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "db:studio": "npm run studio --workspace=@hm/db",
    "clean": "turbo clean && rm -rf node_modules",
    "seed:personas": "tsx apps/api/src/scripts/seed-personas.ts",
    "apor:build": "node scripts/build-apor.mjs",
    "apor:verify": "node scripts/build-apor.mjs --verify",
    "apor:fetch": "tsx apps/api/src/scripts/fetch-apor.ts",
    "apor:vendor": "tsx apps/api/src/scripts/fetch-apor.ts --vendor && node scripts/build-apor.mjs",
    "servicing:db:setup": "npm run db:setup -w @hm/servicing",
    "test:servicing": "npm_config_node_options=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" npm run test -w @hm/servicing --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.0"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true
  }
}
